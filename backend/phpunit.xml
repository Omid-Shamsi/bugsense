<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        APP_ENV, DB_CONNECTION, DB_DATABASE, SESSION_DRIVER, CACHE_STORE, and BCRYPT_ROUNDS
        are intentionally NOT set here. The backend container loads backend/.env via Docker
        Compose's env_file, which sets them as real OS environment variables that take
        precedence over PHPUnit's own <env> values even with force="true". The authoritative,
        working test workflow is the "test" script in composer.json (`composer test`), which
        exports the required overrides at process-start before PHP boots. Run tests with
        `docker compose exec backend composer test`, not `php artisan test` directly.
    -->
    <php>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
